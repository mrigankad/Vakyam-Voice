VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Edge Function secrets (set with `supabase secrets set`, not in this file):
#   VAPI_API_KEY          - Vapi private API key
#   VAPI_ORG_ID           - Vapi organization ID
#   VAPI_ASSISTANT_ID     - Vapi assistant used for web calls
#   VAPI_ALLOWED_ORIGINS  - comma-separated browser origins allowed to start calls, e.g.
#                           https://vakyam-voice.wayam.ai,https://vakyam-voice.vercel.app,http://localhost:8080
