VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Edge Function secrets (set with `supabase secrets set`, not in this file):
#   AZURE_OPENAI_RESOURCE      - Azure AI resource name, e.g. wayam-voice-southindia
#   AZURE_OPENAI_API_KEY       - that resource's API key
#   AZURE_REALTIME_DEPLOYMENT  - name of the realtime model deployment
#   AZURE_REALTIME_VOICE       - optional voice name; defaults to marin
#   AZURE_SPEECH_KEY           - optional Azure Speech key; with the region, Meera speaks with a native Indian voice
#   AZURE_SPEECH_REGION        - that Speech resource's region, e.g. centralindia
#   AZURE_SPEECH_VOICE         - optional Azure neural voice; defaults to en-IN-AartiIndicNeural
#
# Local testing of the function (both files are gitignored):
#   supabase/.env.local        - the secrets above plus SUPABASE_URL and SUPABASE_ANON_KEY
#   .env.local                 - VITE_REALTIME_TOKEN_URL=http://localhost:8000
